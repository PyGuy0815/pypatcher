#PPATCH 1 0001-beispiel
TITLE Subtraktion, Pruefung und Einstellung
AUTHOR beispiel
DESC Zeigt UNIT, UADD, TEXT mit scope und TINS.
DESC Bloecke: "@N ." bis zur Zeile "@." - Tab am Zeilenanfang = eine Ebene tiefer.

FILE src/rechner.py
  UNIT add @1
  UADD after:add @2
  TEXT scope=Rechner.run @3 @4
FILE settings.ini
  TINS after @5 @6

@1 .
# addiert zwei Zahlen (auch Kommazahlen)
def add(a, b):
	return float(a) + float(b)
@.
@2 .
def sub(a, b):
	return float(a) - float(b)
@.
@3 .
if len(args) != 2:
	return None
@.
@4 .
if len(args) != 2:
	raise SystemExit("zwei Zahlen erwartet")
@.
@5 .
modus = add
@.
@6 .
genauigkeit = 2
@.
