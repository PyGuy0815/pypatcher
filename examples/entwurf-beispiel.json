{
  "id": "0001-beispiel",
  "title": "Subtraktion, Pruefung und Einstellung",
  "author": "beispiel",
  "description": "Zeigt replace_unit, add_unit, replace_text mit scope und insert_text.",
  "files": [
    {
      "path": "src/rechner.py",
      "action": "modify",
      "changes": [
        {"op": "replace_unit", "unit": "add",
         "new": ["# addiert zwei Zahlen (auch Kommazahlen)",
                 "def add(a, b):",
                 "\treturn float(a) + float(b)"]},
        {"op": "add_unit", "position": "after:add",
         "new": ["def sub(a, b):",
                 "\treturn float(a) - float(b)"]},
        {"op": "replace_text", "scope": "Rechner.run",
         "old": ["if len(args) != 2:", "\treturn None"],
         "new": ["if len(args) != 2:", "\traise SystemExit(\"zwei Zahlen erwartet\")"]}
      ]
    },
    {
      "path": "settings.ini",
      "action": "modify",
      "changes": [
        {"op": "insert_text", "anchor": ["modus = add"], "position": "after",
         "new": ["genauigkeit = 2"]}
      ]
    }
  ]
}
