"""mode c / cpp - Sprachen der C-Familie (manifest.txt Abschnitte 5.6.4, 7.2).

Normalform c/1: Tokenfolge ohne Kommentare und Leerraum; Zeichenketten,
Zeichenliterale und Praeprozessorzeilen bleiben (Praeprozessorzeilen mit
vereinheitlichtem Leerraum). Einheiten: Funktionsdefinitionen, struct/union/
enum, C++-Klassen und -Methoden, namespace. Adresse mit "::" wie im Code.
Die Erkennung ist heuristisch (kein vollstaendiger C++-Parser): was nicht
eindeutig erkannt wird, ist keine Einheit und wird ueber Textbefehle geaendert.
"""

import bisect
import re
from collections import Counter

from ..errors import PatchInvalid
from ..layout import leading_ws, detect_generic
from .base import Adapter, Info, ParseError, Unit

PUNCT = sorted(("{ } ( ) [ ] ; , < > + - * / % & | ^ ! ~ ? : = . # ... -> ++ -- << >> <= >= "
				"== != && || += -= *= /= %= &= |= ^= :: .* ->* <=> <<= >>= ##").split(),
			   key=len, reverse=True)
NUMBER_RE = re.compile(r"(?:\d|\.\d)(?:[eEpP][+-]|[\w.']|(?<=\d)'(?=\w))*")
RAW_RE = re.compile(r'(?:u8|u|U|L)?R"([^ ()\\\t\n]{0,16})\(')
PREFIX_RE = re.compile(r"(?:u8|u|U|L)(?=['\"])")
TYPE_WORDS = ("struct", "union", "enum", "class")
CLOSE = {"(": ")", "[": "]", "{": "}"}
SPACE = " \t\r\f\v"


class Token(object):
	__slots__ = ("kind", "text", "start", "end", "line")

	def __init__(self, kind, text, start, end):
		self.kind = kind      # nl, comment, pp, str, char, num, name, punct
		self.text = text
		self.start = start
		self.end = end
		self.line = 0


def _scan_quoted(src, i, quote):
	j, n = i + 1, len(src)
	while j < n:
		ch = src[j]
		if ch == "\\":
			j += 2
			continue
		if ch == quote:
			return j + 1
		if ch == "\n":
			break
		j += 1
	raise ParseError("Zeichenkette/Zeichen ohne Ende (Position %d)" % i)


def tokenize(src):
	tokens, i, n = [], 0, len(src)
	line_start = True
	while i < n:
		c = src[i]
		if c == "\n":
			tokens.append(Token("nl", c, i, i + 1))
			i += 1
			line_start = True
			continue
		if c in SPACE:
			i += 1
			continue
		start = i
		if c == "#" and line_start:
			j = i
			while j < n and src[j] != "\n":
				if src.startswith("\\\n", j):
					j += 2
					continue
				if src.startswith("/*", j):
					end = src.find("*/", j + 2)
					if end < 0:
						raise ParseError("Kommentar ohne Ende (Position %d)" % j)
					j = end + 2
					continue
				if src.startswith("//", j):
					while j < n and src[j] != "\n":
						j += 1
					break
				j += 1
			tokens.append(Token("pp", src[i:j], i, j))
			i = j
			continue
		line_start = False
		if src.startswith("//", i):
			j = src.find("\n", i)
			j = n if j < 0 else j
			tokens.append(Token("comment", src[i:j], i, j))
			i = j
			continue
		if src.startswith("/*", i):
			j = src.find("*/", i + 2)
			if j < 0:
				raise ParseError("Kommentar ohne Ende (Position %d)" % i)
			tokens.append(Token("comment", src[i:j + 2], i, j + 2))
			i = j + 2
			continue
		raw = RAW_RE.match(src, i)
		if raw:
			end = src.find(")" + raw.group(1) + '"', raw.end())
			if end < 0:
				raise ParseError("Raw-String ohne Ende (Position %d)" % i)
			i = end + len(raw.group(1)) + 2
			tokens.append(Token("str", src[start:i], start, i))
			continue
		prefix = PREFIX_RE.match(src, i)
		if prefix:
			i = prefix.end()
			c = src[i]
		if c == '"':
			i = _scan_quoted(src, i, '"')
			kind = "str"
		elif c == "'":
			i = _scan_quoted(src, i, "'")
			kind = "char"
		elif c.isdigit() or (c == "." and i + 1 < n and src[i + 1].isdigit()):
			i = NUMBER_RE.match(src, i).end()
			kind = "num"
		elif c.isalpha() or c == "_" or c == "$" or ord(c) > 127:
			j = i + 1
			while j < n and (src[j].isalnum() or src[j] in "_$" or ord(src[j]) > 127):
				j += 1
			i = j
			kind = "name"
		elif c == "\\" and src.startswith("\\\n", i):
			i += 2
			continue
		else:
			for p in PUNCT:
				if src.startswith(p, i):
					break
			else:
				raise ParseError("unerwartetes Zeichen %r (Position %d)" % (c, i))
			i += len(p)
			kind = "punct"
		tokens.append(Token(kind, src[start:i], start, i))
	return tokens


def normal_tokens(tokens, keep_comments=False):
	out = []
	for tok in tokens:
		if tok.kind == "nl":
			continue
		if tok.kind == "comment":
			if keep_comments:
				out.append(tok.text)
			continue
		if tok.kind == "pp":
			text = re.sub(r"/\*.*?\*/|//.*$", " ", tok.text, flags=re.S) if not keep_comments \
				else tok.text
			out.append("\n" + " ".join(text.replace("\\\n", " ").split()) + "\n")
			continue
		out.append(tok.text)
	return " ".join(out)


class Source(object):
	def __init__(self, lines):
		self.lines = lines
		self.text = "\n".join(lines) + "\n"
		self.tokens = tokenize(self.text)
		starts, pos = [], 0
		for line in lines:
			starts.append(pos)
			pos += len(line) + 1
		self.starts = starts
		for tok in self.tokens:
			tok.line = bisect.bisect_right(starts, tok.start) - 1
		self.sig = [t for t in self.tokens if t.kind not in ("nl", "comment", "pp")]
		self.pair, stack = {}, []
		for k, tok in enumerate(self.sig):
			if tok.kind == "punct" and tok.text in CLOSE:
				stack.append(k)
			elif tok.kind == "punct" and tok.text in (")", "]", "}"):
				if not stack or CLOSE[self.sig[stack[-1]].text] != tok.text:
					raise ParseError("Klammer %r passt nicht (Position %d)" % (tok.text, tok.start))
				self.pair[stack.pop()] = k
		if stack:
			raise ParseError("Klammer %r nicht geschlossen (Position %d)"
							 % (self.sig[stack[-1]].text, self.sig[stack[-1]].start))
		code = set(t.line for t in self.sig)
		self.comment_lines = set()
		self.pp_lines = set()
		for tok in self.tokens:
			if tok.kind in ("comment", "pp"):
				last = bisect.bisect_right(starts, tok.end - 1) - 1
				target = self.comment_lines if tok.kind == "comment" else self.pp_lines
				target.update(l for l in range(tok.line, last + 1) if l not in code)

	def text_of(self, k):
		return self.sig[k].text if 0 <= k < len(self.sig) else None

	def line_start(self, k):
		tok = self.sig[k]
		return not self.lines[tok.line][:tok.start - self.starts[tok.line]].strip()

	def line_end(self, k):
		if k + 1 < len(self.sig) and self.sig[k + 1].line == self.sig[k].line:
			return False
		return True


class CLikeAdapter(Adapter):
	mode = "c"
	label = "C"
	has_units = True
	default_indent = "    "
	gap_top = 1
	gap_nested = 1
	dup_re = re.compile(r"#\d+$")
	cpp = False

	# -- Normalform ------------------------------------------------------

	def normalize(self, doc, prof):
		if prof["whitespace"] == "keep":
			return doc.text()
		return normal_tokens(tokenize("\n".join(doc.lines) + "\n"), prof["comments"] == "keep")

	def normalize_unit(self, doc, info, unit, prof):
		if prof["whitespace"] == "keep":
			return "\n".join(info.lines[unit.start:unit.end])
		toks = [t for t in info.src.tokens if unit.start <= t.line < unit.end]
		return normal_tokens(toks, prof["comments"] == "keep")

	def validate(self, doc):
		Source(doc.lines)

	def opens_block(self, line):
		return line.rstrip().endswith("{")

	def closes_block(self, line):
		"""Blockende oder Zugriffsangabe (public:/private:/protected:)."""
		return line.lstrip().startswith("}") or \
			bool(re.match(r"^\s*(public|private|protected)\b[^:]*:\s*$", line))

	def can_contain(self, unit):
		return unit.kind in ("namespace", "class", "struct", "union")

	def rename(self, rel_lines, name):
		if not re.match(r"^[A-Za-z_]\w*$", name or ""):
			raise PatchInvalid("as=%r ist kein gueltiger Name" % name)
		for i, line in enumerate(rel_lines):
			stripped = line.strip()
			if not stripped or stripped.startswith(("//", "/*", "*", "#", "template")):
				continue
			match = re.search(r"\b(struct|union|enum|class|namespace)\s+([A-Za-z_]\w*)", line) or \
				re.search(r"(~?)([A-Za-z_]\w*)\s*\(", line)
			if match:
				return rel_lines[:i] + [line[:match.start(2)] + name + line[match.end(2):]] + \
					rel_lines[i + 1:]
			break
		raise PatchInvalid("keine Kopfzeile zum Umbenennen gefunden")

	def detect_unit(self, doc, info=None):
		try:
			info = info or self.analyze(doc)
		except ParseError:
			return detect_generic(doc.lines)
		src, diffs = info.src, Counter()
		for k, tok in enumerate(src.sig):
			if tok.text == "{" and src.line_end(k) and k in src.pair:
				inner = next((t for t in src.sig[k + 1:src.pair[k]] if t.line > tok.line), None)
				if inner is None:
					continue
				outer = leading_ws(src.lines[tok.line])
				ws = leading_ws(src.lines[inner.line])
				if ws.startswith(outer) and len(ws) > len(outer):
					diffs[ws[len(outer):]] += 1
		return diffs.most_common(1)[0][0] if diffs else detect_generic(doc.lines)

	# -- Einheiten -------------------------------------------------------

	def analyze(self, doc):
		src = Source(doc.lines)
		units = []
		self._scope(src, 0, len(src.sig), None, "", units)
		return Info(doc.lines, units, src=src, start_line=self._start_line(src))

	def _start_line(self, src):
		line = 0
		while line < len(src.lines) and (line in src.comment_lines or line in src.pp_lines or
										 not src.lines[line].strip()):
			line += 1
		return line

	def _scope(self, src, lo, hi, parent, prefix, units):
		found, k = [], lo
		while k < hi:
			# Zugriffsangaben/Sprungmarken (public:, private slots:, label:) ueberspringen
			j = k
			while j < hi and src.sig[j].kind == "name":
				j += 1
			if j > k and src.text_of(j) == ":":
				k = j + 1
				continue
			first = k
			j = k
			while j < hi:                       # Anweisung bis ";" oder "{" (Klammern beachten)
				text = src.text_of(j)
				if text in ("(", "[") and j in src.pair:
					j = src.pair[j] + 1
					continue
				if text in (";", "{", "}"):
					break
				j += 1
			if j >= hi:
				break
			text = src.text_of(j)
			if text in (";", "}"):
				k = j + 1
				continue
			hit = self._classify(src, first, j)
			close = src.pair[j]
			last = close
			if src.text_of(close + 1) == ";" and src.sig[close + 1].line == src.sig[close].line:
				last = close + 1
			if hit is not None and src.line_start(first) and src.line_end(last) and \
					(first == lo or src.sig[first - 1].line < src.sig[first].line):
				name, kind = hit
				found.append((name, kind, first, j, last))
			elif hit is not None and hit[1] == "transparent":
				self._scope(src, j + 1, close, parent, prefix, units)
			k = last + 1
		names = self.label_dups([f[0] for f in found])
		for label, (name, kind, first, body, last) in zip(names, found):
			if kind == "transparent":
				self._scope(src, body + 1, src.pair[body], parent, prefix, units)
				continue
			start = src.sig[first].line
			floor = src.sig[parent.node[1]].line + 1 if parent is not None else 0
			while start - 1 >= floor and start - 1 in src.comment_lines:
				start -= 1
			path = prefix + "::" + label if prefix else label
			if kind == "function" and parent is not None and parent.kind != "namespace":
				kind = "method"
			unit = Unit(path, kind, (first, body, last), start, src.sig[last].line + 1,
						leading_ws(src.lines[src.sig[first].line]), parent)
			units.append(unit)
			if kind in ("namespace", "class", "struct", "union"):
				self._scope(src, body + 1, src.pair[body], unit, path, units)

	def _classify(self, src, first, brace):
		"""Art und Name einer Anweisung mit Block: (name, art) oder None."""
		words = [src.text_of(k) for k in range(first, brace)]
		if not words:
			return None
		if "=" in words:                                 # Initialisierung: int a[] = {...}
			return None
		if words[0] == "extern" and len(words) == 2 and src.sig[first + 1].kind == "str":
			return ("extern", "transparent")
		lead = words[1:] if words[0] == "inline" else words
		if lead and lead[0] == "namespace":
			name = "::".join(w for w in lead[1:] if w != "::") or "(anonym)"
			return (name, "namespace") if self.cpp else None
		if words[0] == "template":
			words = self._skip_template(words)
		for word in TYPE_WORDS:
			if word in words[:3] and "(" not in words:
				pos = words.index(word)
				rest = [w for w in words[pos + 1:] if w not in ("class", "struct")]
				if rest and re.match(r"^[A-Za-z_]\w*$", rest[0]) and rest[0] not in ("final",):
					if word == "class" and not self.cpp:
						return None
					return rest[0], ("struct" if word == "struct" else word)
				return None
		# Funktion: erster "(" auf oberster Ebene, davor ein Name
		for k in range(first, brace):
			if src.text_of(k) == "(" and k in src.pair:
				name = self._qualified_name(src, first, k)
				if name is None:
					return None
				after = src.pair[k] + 1
				tail = [src.text_of(m) for m in range(after, brace)]
				if tail and tail[0] not in ("const", "noexcept", "override", "final", "->", ":",
											"volatile", "&", "&&", "throw", "try", "mutable",
											"requires", "[", "__attribute__", "=") \
						and not self.cpp:
					return None
				return name, "function"
		return None

	@staticmethod
	def _skip_template(words):
		depth, k = 0, 1
		while k < len(words):
			if words[k] == "<":
				depth += 1
			elif words[k] == ">":
				depth -= 1
				if depth == 0:
					return words[k + 1:]
			elif words[k] == ">>":
				depth -= 2
				if depth <= 0:
					return words[k + 1:]
			k += 1
		return words

	def _qualified_name(self, src, first, paren):
		k = paren - 1
		if k < first:
			return None
		parts = []
		tok = src.sig[k]
		if tok.kind == "name":
			parts.append(tok.text)
			k -= 1
			if k >= first and src.text_of(k) == "~":
				parts[-1] = "~" + parts[-1]
				k -= 1
		elif k - 1 >= first and src.text_of(k - 1) == "operator":
			parts.append("operator" + tok.text)
			k -= 2
		elif src.text_of(k) == "operator":
			return None
		else:
			return None
		if parts[0] in ("if", "for", "while", "switch", "return", "sizeof", "catch"):
			return None
		while k - 1 >= first and src.text_of(k) == "::":
			j = k - 1
			if src.text_of(j) in (">", ">>"):            # Box<int>::f -> Box::f
				depth = 0
				while j >= first:
					text = src.text_of(j)
					depth += {">": 1, ">>": 2, "<": -1}.get(text, 0)
					j -= 1
					if depth <= 0 and text == "<":
						break
			if j < first or src.sig[j].kind != "name":
				break
			parts.insert(0, src.text_of(j))
			k = j - 1
		return "::".join(parts)

	def _body(self, unit, info):
		src = info.src
		first, body, last = unit.node
		close = src.pair[body]
		if not src.line_end(body) or not src.line_start(close):
			return None
		inner = src.sig[body + 1:close]
		indent = leading_ws(src.lines[inner[0].line]) if inner else \
			unit.indent + (self.detect_unit(None, info) or self.default_indent)
		return src.sig[body].line + 1, src.sig[close].line, indent

	def position(self, info, pos):
		return self.simple_position(info, pos, lambda unit: self._body(unit, info))


class CAdapter(CLikeAdapter):
	mode = "c"
	label = "C"
	cpp = False


class CppAdapter(CLikeAdapter):
	mode = "cpp"
	label = "C++"
	cpp = True
@2 310
"""mode json - JSON-Daten (manifest.txt Abschnitte 5.6.4, 7.2).

Normalform json/1: die Daten selbst - Formatierung zaehlt nicht, die
Reihenfolge der Schluessel standardmaessig auch nicht (keyorder=keep:
zaehlt). Zahlen bleiben in ihrer Art (1 und 1.0 sind verschieden).
Einheiten: Eintraege von Objekten und Listen ueber ihren Pfad, z.B.
"server/port" oder "plugins/0/name" (JSON-Pointer ohne fuehrendes "/").
Nach Einfuegen/Loeschen/Ersetzen werden fehlende bzw. ueberzaehlige Kommas
an den Grenzen ergaenzt bzw. entfernt (repair) - sonst waere die Datei kein
gueltiges JSON.
"""

import bisect
import json
import re
from collections import Counter

from ..errors import PatchInvalid
from ..layout import leading_ws, detect_generic
from .base import Adapter, Info, ParseError, Unit

WS = " \t\r\n"
NUMBER_RE = re.compile(r"-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?")
VALUE_START = '"{[-0123456789tfn'


class Node(object):
	"""Wert mit Position; bei Objekten/Listen mit Eintraegen (Member)."""

	def __init__(self, kind, start, end=None):
		self.kind = kind          # object, array, value
		self.start = start
		self.end = end
		self.members = []


class Member(object):
	def __init__(self, key, start, value, end, comma):
		self.key = key            # str (Objekt) oder int (Liste)
		self.start = start        # Schluessel bzw. Listenelement
		self.value = value
		self.end = end            # Ende des Werts
		self.comma = comma        # Position des folgenden Kommas oder None


class _Parser(object):
	def __init__(self, text):
		self.text = text
		self.pos = 0

	def fail(self, msg):
		line = self.text.count("\n", 0, self.pos) + 1
		raise ParseError("Zeile %d: %s" % (line, msg))

	def ws(self):
		while self.pos < len(self.text) and self.text[self.pos] in WS:
			self.pos += 1

	def string(self):
		start, i = self.pos, self.pos + 1
		while i < len(self.text):
			ch = self.text[i]
			if ch == "\\":
				i += 2
				continue
			if ch == '"':
				self.pos = i + 1
				try:
					return json.loads(self.text[start:i + 1])
				except ValueError as exc:
					self.fail("Zeichenkette ungueltig (%s)" % exc)
			if ch == "\n":
				break
			i += 1
		self.fail("Zeichenkette ohne Ende")

	def value(self):
		self.ws()
		if self.pos >= len(self.text):
			self.fail("Wert erwartet")
		ch, start = self.text[self.pos], self.pos
		if ch == "{":
			return self.container("object", "}")
		if ch == "[":
			return self.container("array", "]")
		if ch == '"':
			self.string()
		else:
			for word in ("true", "false", "null"):
				if self.text.startswith(word, self.pos):
					self.pos += len(word)
					break
			else:
				match = NUMBER_RE.match(self.text, self.pos)
				if not match or match.end() == self.pos:
					self.fail("Wert erwartet")
				self.pos = match.end()
		return Node("value", start, self.pos)

	def container(self, kind, close):
		node = Node(kind, self.pos)
		self.pos += 1
		self.ws()
		if self.text.startswith(close, self.pos):
			self.pos += 1
			node.end = self.pos
			return node
		index = 0
		while True:
			self.ws()
			start = self.pos
			if kind == "object":
				if not self.text.startswith('"', self.pos):
					self.fail("Schluessel erwartet")
				key = self.string()
				self.ws()
				if not self.text.startswith(":", self.pos):
					self.fail("':' erwartet")
				self.pos += 1
			else:
				key = index
			value = self.value()
			member = Member(key, start, value, value.end, None)
			node.members.append(member)
			index += 1
			self.ws()
			if self.text.startswith(",", self.pos):
				member.comma = self.pos
				self.pos += 1
				continue
			if self.text.startswith(close, self.pos):
				self.pos += 1
				node.end = self.pos
				return node
			self.fail("',' oder '%s' erwartet" % close)


def parse(text):
	parser = _Parser(text)
	root = parser.value()
	parser.ws()
	if parser.pos != len(text):
		parser.fail("Text nach dem Ende der Daten")
	return root


def _canon(value, keep_order):
	if isinstance(value, _Pairs):
		items = value if keep_order else sorted(value, key=lambda kv: kv[0])
		return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + _canon(v, keep_order)
							  for k, v in items) + "}"
	if isinstance(value, list):
		return "[" + ",".join(_canon(v, keep_order) for v in value) + "]"
	return json.dumps(value, ensure_ascii=False)


class _Pairs(list):
	"""Objekt als Liste von (Schluessel, Wert) - behaelt Reihenfolge und Dubletten."""


def canonical(text, keep_order):
	try:
		data = json.loads(text, object_pairs_hook=_Pairs)
	except ValueError as exc:
		raise ParseError(str(exc))
	return _canon(data, keep_order)


def _escape(key):
	return str(key).replace("~", "~0").replace("/", "~1")


class JsonAdapter(Adapter):
	mode = "json"
	label = "JSON"
	has_units = True
	default_indent = "  "
	gap_top = 0
	gap_nested = 0

	def _text(self, lines):
		return "\n".join(lines) + "\n"

	def normalize(self, doc, prof):
		if prof["whitespace"] == "keep":
			return doc.text()
		return canonical(self._text(doc.lines), prof["keyorder"] == "keep")

	def normalize_unit(self, doc, info, unit, prof):
		if prof["whitespace"] == "keep":
			return "\n".join(info.lines[unit.start:unit.end])
		member = unit.node
		value = canonical(info.text[member.value.start:member.value.end], prof["keyorder"] == "keep")
		return json.dumps(member.key, ensure_ascii=False) + ":" + value

	def validate(self, doc):
		text = self._text(doc.lines)
		parse(text)
		canonical(text, True)

	def repair(self, doc):
		"""Kommas an Zeilengrenzen ergaenzen/entfernen, bis die Datei gueltig ist."""
		try:
			parse(self._text(doc.lines))
			return doc
		except ParseError:
			pass
		lines = list(doc.lines)
		rows = [i for i, l in enumerate(lines) if l.strip()]
		for a, b in zip(rows, rows[1:]):
			cur = lines[a].rstrip()
			tail = lines[a][len(cur):]
			nxt = lines[b].lstrip()
			if cur.endswith(",") and nxt[:1] in "}]":
				lines[a] = cur[:-1] + tail
			elif cur and cur[-1] not in ",{[:" and nxt[:1] in VALUE_START:
				lines[a] = cur + "," + tail
		return doc.with_lines(lines)

	def can_contain(self, unit):
		return unit.node.value.kind in ("object", "array")

	def rename(self, rel_lines, name):
		for i, line in enumerate(rel_lines):
			match = re.match(r'^(\s*)"((?:[^"\\]|\\.)*)"(\s*:)', line)
			if match:
				key = json.dumps(name, ensure_ascii=False)
				return rel_lines[:i] + [match.group(1) + key + line[match.start(3):]] + \
					rel_lines[i + 1:]
		raise PatchInvalid("kein Schluessel zum Umbenennen gefunden")

	def detect_unit(self, doc, info=None):
		try:
			info = info or self.analyze(doc)
		except ParseError:
			return detect_generic(doc.lines)
		diffs = Counter()
		for unit in info.units:
			parent = unit.parent
			if parent is not None and unit.start > parent.start:
				outer = leading_ws(info.lines[parent.start])
				if unit.indent.startswith(outer) and len(unit.indent) > len(outer):
					diffs[unit.indent[len(outer):]] += 1
		if not diffs and info.units:
			ws = info.units[0].indent
			if ws:
				return ws
		return diffs.most_common(1)[0][0] if diffs else detect_generic(doc.lines)

	# -- Einheiten -------------------------------------------------------

	def analyze(self, doc):
		text = self._text(doc.lines)
		root = parse(text)
		starts, pos = [], 0
		for line in doc.lines:
			starts.append(pos)
			pos += len(line) + 1
		info = Info(doc.lines, [], text=text, root=root, starts=starts)
		self._collect(info, root, None, "")
		return info

	def _line(self, info, offset):
		return bisect.bisect_right(info.starts, offset) - 1

	def _alone_before(self, info, offset):
		line = self._line(info, offset)
		return not info.text[info.starts[line]:offset].strip()

	def _alone_after(self, info, offset):
		nl = info.text.find("\n", offset)
		return not info.text[offset:nl].strip()

	def _collect(self, info, node, parent, prefix):
		labels = self.label_dups([_escape(m.key) for m in node.members])
		for label, member in zip(labels, node.members):
			end = member.comma + 1 if member.comma is not None and \
				self._line(info, member.comma) == self._line(info, member.end - 1) else member.end
			path = prefix + "/" + label if prefix else label
			if not (self._alone_before(info, member.start) and self._alone_after(info, end)):
				continue
			start = self._line(info, member.start)
			unit = Unit(path, "member" if node.kind == "object" else "item", member, start,
						self._line(info, end - 1) + 1, leading_ws(info.lines[start]), parent)
			unit.container = node
			info.units.append(unit)
			if member.value.kind in ("object", "array"):
				self._collect(info, member.value, unit, path)

	def _body(self, node, info, indent):
		if node.kind not in ("object", "array"):
			return None
		if not self._alone_after(info, node.start + 1) or not self._alone_before(info, node.end - 1):
			return None
		first = self._line(info, node.start) + 1
		last = self._line(info, node.end - 1)
		if node.members:
			indent = leading_ws(info.lines[self._line(info, node.members[0].start)])
		return first, last, indent

	def position(self, info, pos):
		if pos in ("start", "end"):
			root = info.root
			unit = self.detect_unit(None, info) or self.default_indent
			body = self._body(root, info, unit)
			if body is None:
				raise PatchInvalid("Position %r: Wurzel ist nicht zeilenweise abgrenzbar" % pos)
			return (body[0] if pos == "start" else body[1]), body[2], True
		return self.simple_position(info, pos, lambda u: self._body(
			u.node.value, info, u.indent + (self.detect_unit(None, info) or self.default_indent)))
