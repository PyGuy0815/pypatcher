def _save(patch, args):
@130 1
from . import FORMAT, __version__, adapters, diff, engine, fileio, journal as jr, patchfile
@131 1
from . import __version__, adapters, diff, engine, fileio, journal as jr, patchfile
@132 1
import difflib
@133 35
def build(self, meta):
	failing = set()
	for _ in range(MAX_ROUNDS):
		try:
			draft = self._draft(meta)
		except _Retry:
			continue
		sealed = copy.deepcopy(draft)
		ctx = engine.Ctx(self.old_root, seal=True, allow_mixed=self.allow_mixed,
						 config=self.config, no_layout=self.no_layout,
						 source_dir=self.new_root)
		try:
			engine.process(sealed, ctx)
		except (Conflict, PatchInvalid) as exc:
			path = getattr(exc, "path", None)
			if path in self.new.files and path not in self.force_replace:
				self.force_replace.add(path)
				self.cross_units = False
			elif self.cross_units:
				self.cross_units = False
			elif self.level == "unit":
				self.level = "text"
			else:
				raise
			self.hints.append("create: %s - vereinfachter Versuch" % exc)
			continue
		failing = self._verify(ctx)
		if not failing:
			return sealed, ctx
		self.force_replace.update(failing)
		self.cross_units = False
		self.hints.append("nicht exakt als Einzelaenderungen darstellbar, ganze Datei: "
						  + ", ".join(sorted(failing)))
	raise PatchInvalid("create: Patch fuehrt nicht exakt zum neuen Stand (%s)"
					   % ", ".join(sorted(failing)))
@134 44
def _entry(self, rel, plan):
	entry = plan["entry"]
	if entry["action"] != "modify":
		return entry
	changes = []
	unit_o = plan.get("unit_o")
	info_n, unit_n = plan.get("ninfo"), plan.get("unit_n")
	for path, unit in plan["replaces"]:
		base = unit.indent
		rel_new = _rel(_lines(info_n, unit), base, unit_n)
		ch = {"op": "replace_unit", "unit": path}
		if rel_new is None:
			ch["literal"] = True
			ch["new"] = list(_lines(info_n, unit))
		else:
			ch["new"] = rel_new
		changes.append(ch)
	for unit in plan["deletes"]:
		changes.append({"op": "delete_unit", "unit": unit.path})
	for add in plan["adds"]:
		unit, position = add[0], add[1]
		if len(add) > 2:
			ch = dict(add[2], position=position)
		else:
			rel_new = _rel(_lines(info_n, unit), unit.indent, unit_n)
			ch = {"op": "add_unit", "position": position}
			if rel_new is None:
				ch["literal"] = True
				ch["new"] = list(_lines(info_n, unit))
			else:
				ch["new"] = rel_new
		changes.append(ch)
	changes.extend(plan.get("moved_out", []))
	current = self._simulate(rel, plan, changes)
	tail = text_changes(current, plan["ndoc"].lines, plan["prof"],
						unit_o if unit_o is not None else lay.detect_generic(current))
	if tail is None:
		return {"path": rel, "action": "replace", "source": rel}
	changes.extend(tail)
	if not changes or _data_size(changes) >= sum(len(l) + 1 for l in plan["ndoc"].lines):
		# ganze Datei ist kleiner als die Einzelaenderungen (stark umgeschrieben)
		return {"path": rel, "action": "replace", "source": rel}
	entry["changes"] = changes
	return entry
@135 4
def _data_size(changes):
	"""Zeichen der Datenbloecke dieser Aenderungen (Platzbedarf im Patch)."""
	return sum(len(line) + 1 for ch in changes for key in ("old", "new", "anchor")
			   if isinstance(ch.get(key), list) for line in ch[key])
@136 17
def expect(self, obj, key, value, what, level="file"):
	"""seal: Wert eintragen. Sonst: Wert pruefen, sofern der Patch ihn enthaelt
	(welche Pruefungen enthalten sind, bestimmt die Pruefstufe beim Erzeugen)."""
	if self.seal:
		obj[key] = value
		return
	if level == "file" and self.match == "unit":
		return
	if level == "text" and not self.exact:
		return
	stored = obj.get(key)
	if stored is None:
		return
	same = stored == value if key in ("unit", "unit_after") else hash_match(stored, value)
	if not same:
		raise Conflict("%s: %s stimmt nicht\n    erwartet: %s\n    gefunden: %s"
					   % (what, key, stored, value))
@137 16
def op_replace_unit(ctx, path, doc, ch, prof, fs, what):
	_require_py(prof, what)
	info = _info(doc, what)
	unit = _find(info, ch.get("unit"), what)
	ctx.expect(ch, "unit_hash_before", adapters.unit_hash(doc, info, unit, prof), what, "unit")
	new = _abs(ch, "new", unit.indent, fs, what, fs.literal(ch))
	nd = doc.with_lines(doc.lines[:unit.start] + new + doc.lines[unit.end:])
	if unit.kind == "header":
		info2 = _info(nd, what, result=True)
		if info2.units[0].end != len(new):
			raise PatchInvalid("%s: new bildet keinen vollstaendigen Datei-Kopf" % what)
		ctx.expect(ch, "unit_hash_after",
				   adapters.unit_hash(nd, info2, info2.units[0], prof), what, "unit")
		return nd
	_unit_after(ctx, ch, nd, unit.start, unit.start + len(new), prof, what)
	return nd
@138 6
def op_delete_unit(ctx, path, doc, ch, prof, fs, what):
	_require_py(prof, what)
	info = _info(doc, what)
	unit = _find(info, ch.get("unit"), what)
	ctx.expect(ch, "unit_hash_before", adapters.unit_hash(doc, info, unit, prof), what, "unit")
	return _remove(doc, unit.start, unit.end)
@139 24
def op_copy_unit(ctx, path, doc, ch, prof, fs, what):
	_require_py(prof, what)
	src_path, src_name = _split_from(ch.get("from"), path, what)
	if src_path == path:
		sdoc, sprof = doc, prof
	else:
		sprof = ctx.profiles.get(src_path) or pf.resolve(src_path)
		_require_py(sprof, what + " (Quelle)")
		sdoc = ctx.get(src_path, sprof)
		if sdoc is None:
			raise Conflict("%s: Quelldatei %s existiert nicht" % (what, src_path))
	sinfo = _info(sdoc, what + " (Quelle)")
	src = _find(sinfo, src_name, what)
	if src.kind == "header":
		raise PatchInvalid("%s: @header kann nicht kopiert werden" % what)
	ctx.expect(ch, "source_unit_hash", adapters.unit_hash(sdoc, sinfo, src, sprof), what, "unit")
	# Inhalt immer aus der Quelle (durch source_unit_hash gesichert), nicht aus dem Patch
	sunit = fs.unit if src_path == path else PY.detect_unit(sdoc, sinfo)
	rel = lay.to_rel(sdoc.lines[src.start:src.end], src.indent, sunit)
	if rel is None:
		raise Conflict("%s: Quelle ist nicht relativ darstellbar" % what)
	ch["new"] = _rename(rel, ch["as"], what) if ch.get("as") else rel
	ch.pop("literal", None)
	return _place_unit(ctx, doc, ch, prof, fs, what)
@140 26
def op_move_unit(ctx, path, doc, ch, prof, fs, what):
	_require_py(prof, what)
	if "from" in ch:                      # Ziel-Haelfte: einfuegen
		nd = op_copy_unit(ctx, path, doc, ch, prof, fs, what)
		ctx.moves.add(ch["move_id"])
		return nd
	if "to" in ch:                        # Quell-Haelfte: entfernen
		if ch["move_id"] not in ctx.moves:
			raise PatchInvalid("%s: der 'from'-Teil von move_id %r muss vorher ausgefuehrt "
							   "werden" % (what, ch["move_id"]))
		return op_delete_unit(ctx, path, doc, ch, prof, fs, what)
	info = _info(doc, what)
	unit = _find(info, ch.get("unit"), what)
	if unit.kind == "header":
		raise PatchInvalid("%s: @header kann nicht verschoben werden" % what)
	ctx.expect(ch, "unit_hash_before", adapters.unit_hash(doc, info, unit, prof), what, "unit")
	block = doc.lines[unit.start:unit.end]
	rel = lay.to_rel(block, unit.indent, fs.unit)
	if rel is None:
		raise Conflict("%s: Einheit ist nicht relativ darstellbar - move nicht moeglich" % what)
	nd1 = _remove(doc, unit.start, unit.end)
	idx, base, top = _position(_info(nd1, what, result=True), ch, what)
	new = lay.to_abs(rel, base, fs.unit)
	nd, start = _insert(nd1, idx, new, top)
	_unit_after(ctx, ch, nd, start, start + len(new), prof, what)
	return nd
@141 9
def _check_before(ctx, entry, doc, prof, what):
	ctx.expect(entry, "hash_before", _hash(doc, prof, what), what)
	text = adapters.text_hash(doc)
	stored = entry.get("text_hash_before")
	if ctx.exact and not stored and not ctx.seal:
		ctx.hint("%s: --exact ohne Text-Hash im Patch (Pruefstufe full) - nicht geprueft" % what)
	if not ctx.seal and stored and not hash_match(stored, text) and not ctx.exact:
		ctx.hint("%s: kosmetische Abweichung (Kommentare/Leerraum) - wird angewendet" % what)
	ctx.expect(entry, "text_hash_before", text, what, "text")
@142 4
def act_delete(ctx, entry, path, prof, what):
	doc = _existing(ctx, path, prof, what)
	_check_before(ctx, entry, doc, prof, what)
	ctx.set(path, None, prof)
@143 7
def act_replace(ctx, entry, path, prof, what):
	cur = _existing(ctx, path, prof, what)
	_check_before(ctx, entry, cur, prof, what)
	doc = _content_doc(ctx, entry, prof, what, like=cur)
	_validate(doc, prof, what)
	_check_after(ctx, entry, doc, prof, what)
	ctx.set(path, doc, prof)
@144 29
def act_modify(ctx, entry, path, prof, what):
	doc = _existing(ctx, path, prof, what)
	if doc.is_raw:
		raise PatchInvalid("%s: modify ist bei mode raw nicht moeglich" % what)
	_check_before(ctx, entry, doc, prof, what)
	adapter = adapters.get(prof["mode"])
	try:
		detected = adapter.detect_unit(doc)
	except ParseError as exc:
		raise Conflict("%s: Datei ist kein gueltiges Python (%s)" % (what, exc))
	wanted = lay.unit_from_layout(entry.get("layout"))
	if wanted and detected and wanted != detected:
		raise Conflict("%s: Einrueckung der Datei (%s) passt nicht zum layout (%s)"
					   % (what, lay.describe(detected), lay.describe(wanted)))
	fs = FileState(ctx, entry, prof, detected or wanted)
	if ctx.seal and fs.unit and not ctx.no_layout and not wanted:
		entry["layout"] = dict(entry.get("layout") or {}, **lay.layout_for(fs.unit))
	for i, ch in enumerate(entry["changes"], 1):
		cwhat = "%s, Aenderung %d (%s)" % (what, i, ch.get("op"))
		ctx.expect(ch, "file_hash_before", _chain_hash(doc, prof), cwhat)
		doc = OPS[ch["op"]](ctx, path, doc, ch, prof, fs, cwhat)
		ctx.expect(ch, "file_hash_after", _chain_hash(doc, prof), cwhat)
		ctx.set(path, doc, prof)
	# Syntax erst am Ende der Datei: Zwischenstaende von Textaenderungen duerfen
	# ungueltig sein (z.B. Docstring in einem Block geoeffnet, im naechsten geschlossen).
	_validate(doc, prof, what)
	_check_after(ctx, entry, doc, prof, what)
	if ctx.seal and entry["hash_before"] == entry["hash_after"]:
		ctx.hint("%s: aendert nur Kommentare/Leerraum (Funktions-Hash unveraendert)" % what)
@145 17
def _peek_binary(ctx, entry, path):
	"""seal: Binaerdatei ohne Profilangabe -> mode raw."""
	if isinstance(entry.get("new"), dict):
		return True
	src = entry.get("source")
	candidate = os.path.join(ctx.source_dir, src) if src else ctx.abspath(path)
	if not os.path.isfile(candidate):
		return False
	with open(candidate, "rb") as handle:
		data = handle.read(65536)
	if b"\0" in data:
		return True
	try:
		data.decode("utf-8")
	except UnicodeDecodeError:
		return len(data) < 65536
	return False
@146 25
def process(patch, ctx):
	"""Alle Dateieintraege der Reihe nach im Speicher ausfuehren."""
	defaults = (patch.get("defaults") or {}).get("compare")
	project = ctx.config.get("compare")
	required = ctx.config.get("require")
	for n, entry in enumerate(patch["files"], 1):
		path = norm_path(entry["path"])
		what = "Datei %d (%s)" % (n, path)
		project_default = pf.lookup(project, path) if ctx.seal else None
		layer = entry.get("compare")
		if ctx.seal and not pf.has_mode(layer, defaults, project_default) and \
				_peek_binary(ctx, entry, path):
			layer = dict(layer or {}, mode="raw")
		prof = pf.resolve(path, layer, defaults, project_default)
		if ctx.seal:
			entry["compare"] = prof
		if required:
			pf.check_required(prof, path, required)
		if not ctx.seal and "hash_before" not in entry and "hash_after" not in entry:
			ctx.hint("%s: ohne Datei-Hash im Patch - nur Inhaltspruefung" % what)
		try:
			ACTIONS[entry["action"]](ctx, entry, path, prof, what)
		except (Conflict, PatchInvalid) as exc:
			exc.path = path
			raise
@147 7
def _chain_hash(doc, prof):
	"""Datei-Zwischenstand (c=): Funktions-Hash, bei ungueltigem Zwischenstand
	der Text-Hash - auf beiden Seiten eindeutig gleich."""
	try:
		return adapters.file_hash(doc, prof)
	except ParseError:
		return adapters.text_hash(doc)
@148 1
from .patchfile import norm_path
@149 1
from .patchfile import hash_match, norm_path
@150 26
def atomic_write(path, data, st_mode=None):
	"""Temp-Datei im selben Verzeichnis, dann os.replace (atomar je Datei).

	Ohne st_mode erhaelt eine neue Datei die ueblichen Rechte (0666 minus
	umask) statt der restriktiven Rechte der Temp-Datei.
	"""
	if st_mode is None:
		mask = os.umask(0)
		os.umask(mask)
		st_mode = 0o666 & ~mask
	directory = os.path.dirname(path) or "."
	os.makedirs(directory, exist_ok=True)
	fd, tmp = tempfile.mkstemp(prefix=".pptmp-", dir=directory)
	try:
		with os.fdopen(fd, "wb") as handle:
			handle.write(data)
			handle.flush()
			os.fsync(handle.fileno())
		if st_mode is not None:
			os.chmod(tmp, st_mode & 0o7777)
		os.replace(tmp, path)
		drop_bytecode(path)
	except BaseException:
		if os.path.exists(tmp):
			os.remove(tmp)
		raise
@151 19
def drop_bytecode(path):
	"""Zwischengespeicherten Python-Bytecode einer Quelldatei entfernen.

	Python erkennt veralteten Bytecode nur an Aenderungszeit (Sekunden) und
	Groesse der Quelle - wird eine .py-Datei innerhalb einer Sekunde mit
	gleich langem Inhalt ersetzt (Patch, Rollback), liefe sonst alter Code.
	"""
	if not path.endswith((".py", ".pyw")):
		return
	directory, name = os.path.split(path)
	stem = os.path.splitext(name)[0]
	cache = os.path.join(directory, "__pycache__")
	if os.path.isdir(cache):
		for entry in os.listdir(cache):
			if entry.startswith(stem + ".") and entry.endswith((".pyc", ".pyo")):
				try:
					os.remove(os.path.join(cache, entry))
				except OSError:
					pass
@152 62
def commit_apply(self, patch, ctx):
	pid = patch["id"]
	touched = sorted(ctx.touched())
	bdir = self.path("backups", pid)
	if os.path.isdir(bdir):
		shutil.rmtree(bdir)
	meta = {}
	for rel in touched:
		src = self.file(rel)
		meta[rel] = os.path.isfile(src)
		if meta[rel]:
			dst = os.path.join(bdir, "files", *rel.split("/"))
			os.makedirs(os.path.dirname(dst), exist_ok=True)
			shutil.copy2(src, dst)
	write_json(os.path.join(bdir, "meta.json"), {"files": meta})
	write_json(self.path("txn.json"), {"kind": "apply", "id": pid, "phase": "write",
									   "files": meta, "time": now()})
	written = {}
	try:
		for rel in touched:
			doc = ctx.docs[rel]
			target = self.file(rel)
			if doc is None:
				if os.path.isfile(target):
					os.remove(target)
					fileio.drop_bytecode(target)
				continue
			data = fileio.encode(doc)
			fileio.atomic_write(target, data, doc.st_mode)
			written[rel] = data
	except BaseException as exc:
		self.restore(pid, meta)
		os.remove(self.path("txn.json"))
		raise JournalError("Schreiben fehlgeschlagen, Ausgangsstand wiederhergestellt: %s" % exc)
	write_json(self.path("txn.json"), {"kind": "apply", "id": pid, "phase": "journal",
									   "files": meta, "time": now()})
	fileio.atomic_write(self.path("patches", pid + patchfile.EXT),
						patchfile.dumps(patch).encode("utf-8"))
	state = self.state()
	files_info = {}
	for rel in touched:
		before = None
		if meta[rel]:
			before = state["files"].get(rel)
			if before is None:
				data = fileio.read_bytes(os.path.join(bdir, "files", *rel.split("/")))
				before = fingerprint(rel, data, ctx.profiles[rel])
		after = fingerprint(rel, written[rel], ctx.profiles[rel]) if rel in written else None
		files_info[rel] = {"before": before, "after": after}
		if after is None:
			state["files"].pop(rel, None)
		else:
			state["files"][rel] = after
	history = self.history()
	history["applied"].append({"id": pid, "title": patch.get("title", ""),
							   "patch_hash": patch.get("patch_hash"),
							   "applied_at": now(), "files": files_info})
	history["log"].append({"time": now(), "action": "apply", "id": pid})
	write_json(self.path("history.json"), history)
	self._save_state(state["files"])
	os.remove(self.path("txn.json"))
	return files_info
@153 11
def restore(self, pid, meta):
	bdir = self.path("backups", pid, "files")
	for rel, existed in meta.items():
		target = self.file(rel)
		if existed:
			src = os.path.join(bdir, *rel.split("/"))
			fileio.atomic_write(target, fileio.read_bytes(src), os.stat(src).st_mode)
		elif os.path.isfile(target):
			os.remove(target)
			fileio.drop_bytecode(target)
			self._prune_dirs(os.path.dirname(target))
@154 20
def _finish_rollback(self, pid):
	history = self.history()
	entry = next((e for e in history["applied"] if e["id"] == pid), None)
	if entry is not None:
		history["applied"].remove(entry)
		history["log"].append({"time": now(), "action": "rollback", "id": pid})
		write_json(self.path("history.json"), history)
		state = self.state()
		for rel, fps in entry["files"].items():
			if fps["before"] is None:
				state["files"].pop(rel, None)
			else:
				state["files"][rel] = fps["before"]
		self._save_state(state["files"])
	for path in (self.path("patches", pid + patchfile.EXT),):
		if os.path.isfile(path):
			os.remove(path)
	shutil.rmtree(self.path("backups", pid), ignore_errors=True)
	if os.path.isfile(self.path("txn.json")):
		os.remove(self.path("txn.json"))
@155 19
def recover(self):
	txn = self.txn()
	if not txn:
		return None
	pid = txn["id"]
	if txn["kind"] == "apply":
		if pid in self.applied_ids():
			os.remove(self.path("txn.json"))
			return "Patch %s war vollstaendig angewendet - Transaktion abgeschlossen" % pid
		self.restore(pid, txn["files"])
		shutil.rmtree(self.path("backups", pid), ignore_errors=True)
		patch_copy = self.path("patches", pid + patchfile.EXT)
		if os.path.isfile(patch_copy):
			os.remove(patch_copy)
		os.remove(self.path("txn.json"))
		return "Patch %s war unvollstaendig - Ausgangsstand wiederhergestellt" % pid
	self.restore(pid, txn["files"])
	self._finish_rollback(pid)
	return "Rollback von %s abgeschlossen" % pid
@156 626
"""Patchdatei pypatcher/1: Befehlsliste + Datenbloecke, optional in Pakete
geteilt (manifest.txt Abschnitt 6).

Intern wird ein Patch als dict dargestellt (Schluessel wie in Abschnitt 6
beschrieben); dieses Modul uebersetzt zwischen dict und Text.
"""

import glob
import os
import re
import shlex

from . import FORMAT
from .errors import PatchInvalid
from .fileio import atomic_write
from .hashing import sha256_text
from . import profile as pf

EXT = ".ppatch"
MAGIC = "#PPATCH"
FORMAT_VERSION = "1"
LEVELS = ("min", "std", "full")
DEFAULT_HASH_LEN = 16
MIN_HASH_LEN = 8
B64_WIDTH = 76

MODE_SHORT = {"python": "py", "text": "txt", "raw": "raw"}
MODE_LONG = dict((v, k) for k, v in MODE_SHORT.items())

FILE_CMDS = {"ADD": "add", "DEL": "delete", "REP": "replace", "MOVE": "move",
			 "COPY": "copy", "FILE": "modify"}
CHANGE_CMDS = {"UNIT": "replace_unit", "UADD": "add_unit", "UDEL": "delete_unit",
			   "UCOPY": "copy_unit", "UMOVE": "move_unit", "TEXT": "replace_text",
			   "TINS": "insert_text", "TDEL": "delete_text"}
CMD_OF = dict((v, k) for k, v in list(FILE_CMDS.items()) + list(CHANGE_CMDS.items()))
ACTIONS = tuple(FILE_CMDS.values())
OPS = tuple(CHANGE_CMDS.values())
KEYS = ("h", "t", "u", "c", "s", "ind", "nl", "eof", "src", "as", "after", "to", "id",
		"scope")
META = ("TITLE", "DESC", "AUTHOR", "DATE", "GEN", "REQ", "MATCH", "DEFAULT", "STATE")

ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
BLOCK_RE = re.compile(r"^@(\d+)(?:\s+(\d+|\.)(?:\s+(lit|b64))?)?\s*$")
REF_RE = re.compile(r"^@(\d+)$")
POS_RE = re.compile(r"^(start|end|(after|before|start-of|end-of):\S+)$")
PROFILE_RE = re.compile(r"^(py|txt|raw)(,[a-z_]+=[^,\s]*)*$")
PART_RE = re.compile(r"^(.*)\.(\d+)" + re.escape(EXT) + "$")


# -- Hilfen ------------------------------------------------------------------

def norm_path(path, what="Pfad"):
	"""Relativer Projektpfad mit "/"; keine absoluten Pfade, kein "..", nicht .patcher."""
	if not isinstance(path, str) or not path.strip():
		raise PatchInvalid("%s fehlt" % what)
	p = path.replace("\\", "/")
	while p.startswith("./"):
		p = p[2:]
	parts = p.split("/")
	if (p.startswith("/") or re.match(r"^[A-Za-z]:", p)
			or any(part in ("", ".", "..") for part in parts) or parts[0] == ".patcher"):
		raise PatchInvalid("%s ungueltig: %r" % (what, path))
	return p


def short(value, length=None):
	"""Hash ohne "sha256:"-Praefix, auf length Zeichen gekuerzt."""
	hexpart = value.split(":", 1)[-1]
	return hexpart[:length] if length else hexpart


def hash_match(stored, computed):
	"""Gespeicherter (evtl. gekuerzter) Hash passt zum berechneten?"""
	stored = short(str(stored)).lower()
	return len(stored) >= MIN_HASH_LEN and short(computed).startswith(stored)


def _quote(token):
	if token and not re.search(r"[\s\"'\\#]", token):
		return token
	return '"' + token.replace("\\", "\\\\").replace('"', '\\"') + '"'


def profile_short(prof):
	"""Profil als Kurzform; nur Abweichungen von den Vorgaben."""
	if not prof:
		return None
	mode = prof.get("mode", "text")
	options = pf.MODES[mode][1]
	opts = []
	for key, value in sorted(prof.items()):
		if key == "mode":
			continue
		allowed = options.get(key)
		default = allowed[0] if allowed else pf.FREE_DEFAULTS.get(key)
		if value != default:
			opts.append("%s=%s" % (key, "" if value is None else value))
	return ",".join([MODE_SHORT[mode]] + opts)


def profile_long(token):
	parts = token.split(",")
	prof = {"mode": MODE_LONG[parts[0]]}
	for part in parts[1:]:
		key, value = part.split("=", 1)
		prof[key] = value if value != "" else None
	return prof


def _pair(before, after, length):
	""""B>A", ">A" (nur nachher) oder "B" (nur vorher)."""
	if not before and not after:
		return None
	if not after:
		return short(before, length)
	return "%s>%s" % (short(before, length) if before else "", short(after, length))


def _split_pair(value):
	before, sep, after = value.partition(">")
	return before or None, (after or None) if sep else None


# -- Schreiben ---------------------------------------------------------------

class _Writer(object):
	def __init__(self, level, hash_len):
		if level not in LEVELS:
			raise PatchInvalid("Pruefstufe muss %s sein" % ", ".join(LEVELS))
		self.level = level
		self.hash_len = hash_len
		self.blocks = []

	def block(self, lines, flag=None):
		n = len(self.blocks) + 1
		if flag == "b64":
			data = lines["base64"]
			lines = [data[i:i + B64_WIDTH] for i in range(0, len(data), B64_WIDTH)]
		head = "@%d %d" % (n, len(lines)) + (" " + flag if flag else "")
		self.blocks.append([head] + list(lines))
		return "@%d" % n

	def pair(self, tokens, key, obj, before, after):
		value = _pair(obj.get(before), obj.get(after), self.hash_len)
		if value:
			tokens.append("%s=%s" % (key, value))

	def entry(self, entry):
		action = entry["action"]
		tokens = [CMD_OF[action], _quote(entry["path"])]
		if action in ("move", "copy"):
			tokens.append(_quote(entry["to"]))
		prof = profile_short(entry.get("compare"))
		if prof:
			tokens.append(prof)
		self.pair(tokens, "h", entry, "hash_before", "hash_after")
		if self.level == "full":
			self.pair(tokens, "t", entry, "text_hash_before", "text_hash_after")
		layout = entry.get("layout") or {}
		if layout.get("indent") == "tabs":
			tokens.append("ind=tab")
		elif layout.get("indent") == "spaces":
			tokens.append("ind=%d" % layout["width"])
		if entry.get("newline"):
			tokens.append("nl=" + entry["newline"])
		if entry.get("final_newline") is False:
			tokens.append("eof=0")
		if entry.get("source"):
			tokens.append("src=" + _quote(entry["source"]))
		elif action in ("add", "replace") and "new" in entry:
			new = entry["new"]
			if isinstance(new, dict):
				tokens.append(self.block(new, "b64"))
			else:
				tokens.append(self.block(new, "lit" if entry.get("literal") else None))
		out = [" ".join(tokens)]
		for ch in entry.get("changes") or []:
			out.append("  " + self.change(ch))
		return out

	def change(self, ch):
		op = ch["op"]
		flag = "lit" if ch.get("literal") else None
		tokens = [CMD_OF[op]]
		if op in ("replace_unit", "delete_unit"):
			tokens.append(ch["unit"])
		elif op == "add_unit":
			if ch.get("unit"):
				tokens.append(ch["unit"])
			tokens.append(ch["position"])
		elif op == "copy_unit":
			tokens += [_quote(ch["from"]), ch["position"]]
		elif op == "move_unit":
			if "from" in ch:
				tokens += [_quote(ch["from"]), ch["position"]]
			elif "to" in ch:
				tokens += [ch["unit"], "to=" + _quote(ch["to"])]
			else:
				tokens += [ch["unit"], ch["position"]]
			if ch.get("move_id"):
				tokens.append("id=" + ch["move_id"])
		elif op == "insert_text":
			tokens.append(ch["position"])
		if ch.get("as"):
			tokens.append("as=" + ch["as"])
		if ch.get("scope"):
			tokens.append("scope=" + ch["scope"])
		if self.level != "min":
			if ch.get("unit_after") and ch["unit_after"] != ch.get("unit"):
				tokens.append("after=" + ch["unit_after"])
			self.pair(tokens, "u", ch, "unit_hash_before", "unit_hash_after")
			if ch.get("source_unit_hash"):
				tokens.append("s=" + short(ch["source_unit_hash"], self.hash_len))
		if self.level == "full":
			self.pair(tokens, "c", ch, "file_hash_before", "file_hash_after")
		if op in ("replace_text", "delete_text"):
			tokens.append(self.block(ch["old"], flag))
		if op == "insert_text":
			tokens.append(self.block(ch["anchor"], flag))
		if op in ("replace_unit", "add_unit", "replace_text", "insert_text"):
			tokens.append(self.block(ch["new"], flag))
		return " ".join(tokens)


def dumps_body(patch, level="full", hash_len=None):
	"""Befehlsliste + Datenbloecke (ohne Kopfzeile)."""
	writer = _Writer(level, hash_len)
	lines = ["TITLE " + patch["title"]]
	for line in (patch.get("description") or "").splitlines():
		lines.append("DESC " + line)
	for key, meta in (("author", "AUTHOR"), ("created", "DATE"), ("generator", "GEN")):
		if patch.get(key):
			lines.append("%s %s" % (meta, patch[key]))
	if patch.get("requires"):
		lines.append("REQ " + " ".join(patch["requires"]))
	if patch.get("match", "file") != "file":
		lines.append("MATCH " + patch["match"])
	default = (patch.get("defaults") or {}).get("compare")
	if default:
		lines.append("DEFAULT " + profile_short(default))
	state = _pair(patch.get("state_before"), patch.get("state_after"), hash_len)
	if state:
		lines.append("STATE " + state)
	for entry in patch["files"]:
		lines.extend(writer.entry(entry))
	for block in writer.blocks:
		lines.extend(block)
	return "\n".join(lines) + "\n"


def dumps(patch, level="full", hash_len=None):
	"""Einteiliger Patch als Text (Kopfzeile + Inhalt)."""
	body = dumps_body(patch, level, hash_len)
	return "%s %s %s %s\n%s" % (MAGIC, FORMAT_VERSION, patch["id"],
								short(sha256_text(body), hash_len or DEFAULT_HASH_LEN), body)


def split(patch_id, body, max_size, hash_len=DEFAULT_HASH_LEN):
	"""Inhalt in Pakete mit hoechstens max_size Zeichen teilen (nur an Zeilengrenzen)."""
	total = short(sha256_text(body), hash_len)
	if not max_size:
		return ["%s %s %s %s\n%s" % (MAGIC, FORMAT_VERSION, patch_id, total, body)]
	head_len = len("%s %s %s %s 999/999 %s\n" % (MAGIC, FORMAT_VERSION, patch_id, total,
												 "0" * hash_len))
	budget = max_size - head_len
	if budget < 80:
		raise PatchInvalid("--max-size %d ist zu klein" % max_size)
	chunks, cur, size = [], [], 0
	for line in body.splitlines(True):
		if len(line) > budget:
			raise PatchInvalid("Zeile mit %d Zeichen passt nicht in ein Paket (--max-size)"
							   % len(line))
		if size + len(line) > budget:
			chunks.append("".join(cur))
			cur, size = [], 0
		cur.append(line)
		size += len(line)
	chunks.append("".join(cur))
	if len(chunks) == 1:
		return ["%s %s %s %s\n%s" % (MAGIC, FORMAT_VERSION, patch_id, total, body)]
	n = len(chunks)
	return ["%s %s %s %s %d/%d %s\n%s" % (MAGIC, FORMAT_VERSION, patch_id, total, i, n,
										  short(sha256_text(chunk), hash_len), chunk)
			for i, chunk in enumerate(chunks, 1)]


def part_paths(path, count):
	if count == 1:
		return [path]
	stem = path[:-len(EXT)] if path.endswith(EXT) else path
	return ["%s.%d%s" % (stem, i, EXT) for i in range(1, count + 1)]


def save(patch, path, level="std", hash_len=DEFAULT_HASH_LEN, max_size=None):
	"""Patch schreiben; liefert (Liste der Dateien, Gesamt-Hash)."""
	body = dumps_body(patch, level, hash_len)
	parts = split(patch["id"], body, max_size, hash_len)
	paths = part_paths(path, len(parts))
	for target, text in zip(paths, parts):
		atomic_write(target, text.encode("utf-8"))
	return paths, short(sha256_text(body), hash_len)


# -- Lesen -------------------------------------------------------------------

def _read(path):
	try:
		with open(path, encoding="utf-8", newline="") as handle:
			text = handle.read()
	except OSError as exc:
		raise PatchInvalid("%s: nicht lesbar (%s)" % (path, exc))
	except UnicodeDecodeError as exc:
		raise PatchInvalid("%s: kein UTF-8 (%s)" % (path, exc))
	text = text.replace("\r\n", "\n")
	head, _, body = text.partition("\n")
	tokens = head.split()
	if len(tokens) < 3 or tokens[0] != MAGIC:
		raise PatchInvalid("%s: keine pypatcher-Datei (erste Zeile '%s ...' erwartet)"
						   % (path, MAGIC))
	if tokens[1] != FORMAT_VERSION:
		raise PatchInvalid("%s: Formatversion %s wird nicht unterstuetzt" % (path, tokens[1]))
	return tokens[2:], body


def _collect_parts(path, pid, total, count):
	"""Alle Pakete eines Patches finden (gleicher Name mit .N oder gleiche Kennung)."""
	match = PART_RE.match(path)
	candidates = []
	if match:
		candidates = ["%s.%d%s" % (match.group(1), i, EXT) for i in range(1, count + 1)]
	if not all(os.path.isfile(c) for c in candidates):
		candidates = sorted(glob.glob(os.path.join(os.path.dirname(path) or ".", "*" + EXT)))
	found = {}
	for candidate in candidates:
		if not os.path.isfile(candidate):
			continue
		head, body = _read(candidate)
		if len(head) == 4 and head[0] == pid and head[1] == total:
			index, _, n = head[2].partition("/")
			if int(n) != count:
				raise PatchInvalid("%s: Paketanzahl passt nicht" % candidate)
			if not hash_match(head[3], sha256_text(body)):
				raise PatchInvalid("%s: Paket beschaedigt (Paket-Hash stimmt nicht)" % candidate)
			found[int(index)] = body
	missing = [str(i) for i in range(1, count + 1) if i not in found]
	if missing:
		raise PatchInvalid("Patch %s: Pakete fehlen: %s von %d" % (pid, ", ".join(missing), count))
	return "".join(found[i] for i in range(1, count + 1))


def load(path, verify=True):
	"""Patch (oder Entwurf) laden; mehrteilige Patches werden zusammengesetzt."""
	head, body = _read(path)
	pid = head[0]
	total = head[1] if len(head) > 1 else None
	if len(head) == 4:
		count = int(head[2].partition("/")[2])
		body = _collect_parts(path, pid, total, count)
	if verify:
		if total is None:
			raise PatchInvalid("%s: Entwurf ohne Patch-Hash - zuerst versiegeln (seal)" % path)
		if not hash_match(total, sha256_text(body)):
			raise PatchInvalid("%s: Patch-Hash stimmt nicht - Datei beschaedigt oder veraendert"
							   % path)
	patch = parse_body(body, path)
	patch["id"] = pid
	if total is not None:
		patch["patch_hash"] = total
	return patch


def _blocks(lines, where):
	blocks, i = {}, 0
	while i < len(lines):
		match = BLOCK_RE.match(lines[i])
		if not match or match.group(2) is None:
			raise PatchInvalid("%s: Datenblock erwartet in Zeile '%s'" % (where, lines[i][:60]))
		n, count, flag = int(match.group(1)), match.group(2), match.group(3)
		i += 1
		if count == ".":
			end = i
			while end < len(lines) and lines[end] != "@.":
				end += 1
			if end == len(lines):
				raise PatchInvalid("%s: Block @%d ohne Ende '@.'" % (where, n))
			content, i = lines[i:end], end + 1
		else:
			content = lines[i:i + int(count)]
			if len(content) != int(count):
				raise PatchInvalid("%s: Block @%d unvollstaendig" % (where, n))
			i += int(count)
		if n in blocks:
			raise PatchInvalid("%s: Block @%d doppelt" % (where, n))
		blocks[n] = (content, flag)
	return blocks


def _split_tokens(line, where):
	try:
		tokens = shlex.split(line, posix=True)
	except ValueError as exc:
		raise PatchInvalid("%s: Zeile nicht lesbar (%s): %s" % (where, exc, line[:60]))
	keys, pos, refs = {}, [], []
	for token in tokens[1:]:
		key, sep, value = token.partition("=")
		if sep and key in KEYS:
			keys[key] = value
		elif REF_RE.match(token):
			refs.append(int(token[1:]))
		else:
			pos.append(token)
	return tokens[0], pos, keys, refs


class _Reader(object):
	def __init__(self, blocks, where):
		self.blocks = blocks
		self.where = where
		self.used = set()

	def data(self, ref, owner):
		if ref not in self.blocks:
			raise PatchInvalid("%s: Block @%d fehlt" % (self.where, ref))
		self.used.add(ref)
		content, flag = self.blocks[ref]
		if flag == "lit":
			owner["literal"] = True
		if flag == "b64":
			return {"base64": "".join(content)}
		return list(content)

	def entry(self, cmd, pos, keys, refs, line):
		what = "%s: %s" % (self.where, line[:60])
		entry = {"action": FILE_CMDS[cmd]}
		if pos and PROFILE_RE.match(pos[-1]) and len(pos) > 1:
			entry["compare"] = profile_long(pos.pop())
		need = 2 if cmd in ("MOVE", "COPY") else 1
		if len(pos) != need:
			raise PatchInvalid("%s: %d Pfad(e) erwartet" % (what, need))
		entry["path"] = pos[0]
		if need == 2:
			entry["to"] = pos[1]
		self._hashes(entry, keys, "h", "hash_before", "hash_after")
		self._hashes(entry, keys, "t", "text_hash_before", "text_hash_after")
		if "ind" in keys:
			ind = keys["ind"]
			entry["layout"] = {"indent": "tabs"} if ind == "tab" else \
				{"indent": "spaces", "width": self._int(ind, what)}
		if "nl" in keys:
			entry["newline"] = keys["nl"]
		if keys.get("eof") == "0":
			entry["final_newline"] = False
		if "src" in keys:
			entry["source"] = keys["src"]
		if refs:
			if cmd not in ("ADD", "REP") or len(refs) != 1:
				raise PatchInvalid("%s: Datenblock hier nicht erlaubt" % what)
			entry["new"] = self.data(refs[0], entry)
		if cmd == "FILE":
			entry["changes"] = []
		return entry

	def change(self, cmd, pos, keys, refs, line):
		what = "%s: %s" % (self.where, line[:60])
		op = CHANGE_CMDS[cmd]
		ch = {"op": op}
		units = [p for p in pos if not POS_RE.match(p) and p not in ("before", "after")]
		places = [p for p in pos if POS_RE.match(p)]
		if op in ("replace_unit", "delete_unit"):
			self._expect(units, 1, what)
			ch["unit"] = units[0]
		elif op == "add_unit":
			self._expect(places, 1, what)
			ch["position"] = places[0]
			if units:
				ch["unit"] = units[0]
		elif op == "copy_unit":
			self._expect(units, 1, what)
			self._expect(places, 1, what)
			ch["from"], ch["position"] = units[0], places[0]
		elif op == "move_unit":
			self._expect(units, 1, what)
			if "to" in keys:
				ch["unit"], ch["to"] = units[0], keys["to"]
			elif "id" in keys:
				self._expect(places, 1, what)
				ch["from"], ch["position"] = units[0], places[0]
			else:
				self._expect(places, 1, what)
				ch["unit"], ch["position"] = units[0], places[0]
			if "id" in keys:
				ch["move_id"] = keys["id"]
		elif op == "insert_text":
			where = [p for p in pos if p in ("before", "after")]
			self._expect(where, 1, what)
			ch["position"] = where[0]
		for key, name in (("as", "as"), ("scope", "scope"), ("after", "unit_after"),
						  ("s", "source_unit_hash")):
			if key in keys:
				ch[name] = keys[key]
		self._hashes(ch, keys, "u", "unit_hash_before", "unit_hash_after")
		self._hashes(ch, keys, "c", "file_hash_before", "file_hash_after")
		names = {"replace_unit": ("new",), "add_unit": ("new",), "replace_text": ("old", "new"),
				 "insert_text": ("anchor", "new"), "delete_text": ("old",),
				 }.get(op, ())
		if len(refs) != len(names):
			raise PatchInvalid("%s: %d Datenblock/-bloecke erwartet" % (what, len(names)))
		for name, ref in zip(names, refs):
			ch[name] = self.data(ref, ch)
		return ch

	@staticmethod
	def _hashes(obj, keys, key, before, after):
		if key in keys:
			b, a = _split_pair(keys[key])
			if b:
				obj[before] = b
			if a:
				obj[after] = a

	@staticmethod
	def _expect(values, count, what):
		if len(values) != count:
			raise PatchInvalid("%s: Angaben unvollstaendig" % what)

	@staticmethod
	def _int(value, what):
		try:
			return int(value)
		except ValueError:
			raise PatchInvalid("%s: Zahl erwartet: %r" % (what, value))


def parse_body(body, where="Patch"):
	lines = body.split("\n")
	if lines and lines[-1] == "":
		lines.pop()
	first = next((i for i, l in enumerate(lines) if BLOCK_RE.match(l)), len(lines))
	reader = _Reader(_blocks(lines[first:], where), where)
	patch = {"format": FORMAT, "files": [], "requires": [], "match": "file"}
	desc = []
	entry = None
	for raw in lines[:first]:
		line = raw.rstrip()
		if not line.strip() or line.lstrip().startswith("#"):
			continue
		word, _, rest = line.strip().partition(" ")
		if word in META and not raw[:1].isspace():
			if word == "TITLE":
				patch["title"] = rest
			elif word == "DESC":
				desc.append(rest)
			elif word == "AUTHOR":
				patch["author"] = rest
			elif word == "DATE":
				patch["created"] = rest
			elif word == "GEN":
				patch["generator"] = rest
			elif word == "REQ":
				patch["requires"] = rest.split()
			elif word == "MATCH":
				patch["match"] = rest.strip()
			elif word == "DEFAULT":
				patch["defaults"] = {"compare": profile_long(rest.strip())}
			elif word == "STATE":
				b, a = _split_pair(rest.strip())
				patch["state_before"], patch["state_after"] = b, a
			continue
		cmd, pos, keys, refs = _split_tokens(line.strip(), where)
		if cmd in FILE_CMDS and not raw[:1].isspace():
			entry = reader.entry(cmd, pos, keys, refs, line.strip())
			patch["files"].append(entry)
		elif cmd in CHANGE_CMDS:
			if entry is None or entry["action"] != "modify":
				raise PatchInvalid("%s: %s nur innerhalb eines FILE-Befehls" % (where, cmd))
			entry["changes"].append(reader.change(cmd, pos, keys, refs, line.strip()))
		else:
			raise PatchInvalid("%s: unbekannter Befehl %r" % (where, cmd))
	unused = sorted(set(reader.blocks) - reader.used)
	if unused:
		raise PatchInvalid("%s: Datenbloecke ohne Befehl: %s" % (where, ", ".join(
			"@%d" % n for n in unused)))
	if desc:
		patch["description"] = "\n".join(desc)
	return patch


# -- Pruefung ----------------------------------------------------------------

def validate(patch, sealed=True):
	"""Struktur pruefen (Inhalte prueft die Engine)."""
	for key in ("id", "title"):
		if not isinstance(patch.get(key), str) or not patch[key].strip():
			raise PatchInvalid("%s fehlt" % ("Kennung (id)" if key == "id" else "TITLE"))
	if not ID_RE.match(patch["id"]):
		raise PatchInvalid("id %r: erlaubt sind Buchstaben, Ziffern, '.', '_', '-'" % patch["id"])
	if patch.get("match", "file") not in ("file", "state", "unit"):
		raise PatchInvalid("MATCH muss file, state oder unit sein")
	if not patch.get("files"):
		raise PatchInvalid("Patch enthaelt keine Befehle")
	moves = {}
	for n, entry in enumerate(patch["files"], 1):
		path = norm_path(entry.get("path"), "Datei %d: Pfad" % n)
		what = "Datei %d (%s)" % (n, path)
		if entry.get("action") not in ACTIONS:
			raise PatchInvalid("%s: unbekannte Aktion" % what)
		if entry["action"] in ("move", "copy"):
			norm_path(entry.get("to"), what + ": Ziel")
		if entry["action"] in ("add", "replace") and "new" not in entry and "source" not in entry:
			raise PatchInvalid("%s: Inhalt fehlt" % what)
		if entry["action"] == "modify" and not entry.get("changes"):
			raise PatchInvalid("%s: FILE ohne Aenderungen" % what)
		for i, ch in enumerate(entry.get("changes") or [], 1):
			cwhat = "%s, Aenderung %d" % (what, i)
			if ch.get("op") not in OPS:
				raise PatchInvalid("%s: unbekannte Aenderung" % cwhat)
			if ch["op"] == "move_unit" and ("from" in ch or "to" in ch):
				if not ch.get("move_id"):
					raise PatchInvalid("%s: UMOVE zwischen Dateien braucht id=" % cwhat)
				if "to" in ch:
					norm_path(ch["to"], cwhat + ": to")
				moves.setdefault(ch["move_id"], []).append("from" if "from" in ch else "to")
	for mid, halves in moves.items():
		if sorted(halves) != ["from", "to"]:
			raise PatchInvalid("UMOVE id=%s: es muessen genau ein Quell- und ein Zielteil "
							   "vorhanden sein" % mid)
@157 96
PYPATCHER - README
==================

Version 0.0.1-pre1 (Vorabversion, Testphase).
Die ausfuehrliche Beschreibung steht in manifest.txt.

Was macht der Patcher?
----------------------
Er uebertraegt Aenderungen an einem Projekt mit einer kompakten
Patchdatei (*.ppatch) in eine andere Umgebung - ohne ganze Dateien zu
kopieren. Die Patchdatei ist eine Befehlsliste, die von oben nach unten
abgearbeitet wird, gefolgt von den Daten (Code/Text unveraendert). Bei
begrenzter Uebertragungsgroesse wird sie auf Wunsch in Pakete geteilt.

Aenderungen koennen bis auf einzelne Funktionen/Methoden genau
beschrieben werden ("ersetze in Datei X die Funktion Y"). Funktionen/
Klassen koennen ersetzt, eingefuegt, geloescht, kopiert und verschoben
werden; innerhalb einer Funktion lassen sich auch einzelne Zeilen aendern.

Geprueft wird per SHA-256 - so viel wie gewuenscht: nur die Datei (min),
zusaetzlich jede betroffene Funktion (std, Standard) oder alles (full).
Geprueft wird die Funktion, nicht die Schreibweise: Kommentare und
unwichtige Leerzeichen/Tabs/Umbrueche zaehlen je nach Format nicht; bei
Python zaehlt die Einrueckung immer exakt. Jeder angewendete Patch laesst
sich exakt zuruecknehmen (Sicherung im Ziel). Windows-Zeilenenden (CRLF)
bleiben erhalten.

Voraussetzungen
---------------
Python 3.8 oder neuer, keine weiteren Pakete. Getestet mit 3.8, 3.11,
3.12 und 3.13. Aufruf: python3 patcher.py BEFEHL ... (das Verzeichnis
pypatcher/ muss neben patcher.py liegen).

So sieht ein Patch aus
----------------------
	 #PPATCH 1 0002-fix 9f2c41d07ab3e118
	 TITLE add rechnet mit Kommazahlen
	 FILE src/rechner.py py h=aa11f0c2d9e4b7a1>ff9903e1c5a7b2d4 ind=4
		 UNIT add u=cc33a1b2c3d4e5f6>dd4401a2b3c4d5e6 @1
	 @1 2
	 def add(a, b):
	 	return float(a) + float(b)

Ein Tab am Zeilenanfang = eine Einrueckungs-Ebene tiefer als die Funktion
selbst; die echte Einrueckung ergibt sich aus der Zieldatei.
Alle Befehle: manifest.txt Abschnitt 6.4.

Typischer Ablauf
----------------
1. Patch erzeugen - automatisch aus zwei Staenden:
	 python3 patcher.py create alt/ neu/ -o 0002-fix.ppatch \
			 --id 0002-fix --title "add rechnet mit Kommazahlen"
	 oder einen Entwurf von Hand schreiben (wie oben, ohne Hashes, Bloecke
	 mit "@1 ." bis "@.") und versiegeln:
	 python3 patcher.py seal entwurf.ppatch --base projekt/ -o 0002-fix.ppatch

	 Optionen fuer beide: --verify min|std|full, --hash-len 16,
	 --max-size 8000 (Pakete 0002-fix.1.ppatch, .2.ppatch ...).

2. Anzeigen:
	 python3 patcher.py show 0002-fix.ppatch

3. Zielumgebung:
	 python3 patcher.py init     -p projekt/          (einmalig)
	 python3 patcher.py check    0002-fix.ppatch -p projekt/   (Probelauf)
	 python3 patcher.py apply    0002-fix.ppatch -p projekt/
	 python3 patcher.py status   -p projekt/
	 python3 patcher.py verify   -p projekt/          (Ist-Stand pruefen)
	 python3 patcher.py rollback -p projekt/          (letzten Patch zuruecknehmen)
	 Bei Paketen genuegt ein beliebiges Paket als Angabe; die uebrigen
	 muessen im selben Verzeichnis liegen.

Weitere Befehle: log, units, recover - siehe "python3 patcher.py -h" und
manifest.txt Abschnitt 13. Spaeter: doctor, canon, invert.

Exit-Codes: 0 OK, 1 Bedienfehler, 2 Patch ungueltig, 3 Konflikt,
4 Journalfehler, 5 interner Fehler.

Beispiel ausprobieren
---------------------
	 cp -r examples/demo /tmp/ziel
	 python3 patcher.py seal examples/entwurf-beispiel.ppatch --base examples/demo -o /tmp/p.ppatch
	 python3 patcher.py init -p /tmp/ziel
	 python3 patcher.py apply /tmp/p.ppatch -p /tmp/ziel
	 python3 patcher.py rollback -p /tmp/ziel

Tests
-----
	 cd tests && python3 -m unittest

Dokumentation
-------------
	readme.txt     diese Kurzanleitung
	manifest.txt   ausfuehrliche Programmbeschreibung
	changelog.txt  Aenderungshistorie
	request.txt    Wuensche fuer kuenftige Aenderungen
