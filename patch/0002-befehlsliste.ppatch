@1 36
#PPATCH 1 0001-beispiel
TITLE Subtraktion, Pruefung und Einstellung
AUTHOR beispiel
DESC Zeigt UNIT, UADD, TEXT mit scope und TINS.
DESC Bloecke: "@N ." bis zur Zeile "@." - Tab am Zeilenanfang = eine Ebene tiefer.

FILE src/rechner.py
  UNIT add @1
  UADD after:add @2
  TEXT scope=Rechner.run @3 @4
FILE settings.ini
  TINS after @5 @6

@1 .
# addiert zwei Zahlen (auch Kommazahlen)
def add(a, b):
	return float(a) + float(b)
@.
@2 .
def sub(a, b):
	return float(a) - float(b)
@.
@3 .
if len(args) != 2:
	return None
@.
@4 .
if len(args) != 2:
	raise SystemExit("zwei Zahlen erwartet")
@.
@5 .
modus = add
@.
@6 .
genauigkeit = 2
@.
@2 109
"""Patchformat pypatcher/1: Befehlsliste, Datenbloecke, Pakete, Pruefstufen."""

import os
import unittest

from helpers import ProjectCase

from pypatcher import patchfile
from pypatcher.errors import PatchInvalid

MODULE = "def add(a, b):\n    return a + b\n\n\nclass K:\n    def run(self):\n        return 1\n"


class Format(ProjectCase):
	def setUp(self):
		super().setUp()
		self.write("m.py", MODULE)
		self.write("notes.txt", "eins\nzwei\n")
		self.draft = {"id": "0001-f", "title": "Format", "description": "Zeile 1\nZeile 2",
					  "files": [
						  {"path": "m.py", "action": "modify", "changes": [
							  {"op": "replace_unit", "unit": "K.run",
							   "new": ["def run(self):", "\treturn 2"]},
							  {"op": "add_unit", "position": "after:add",
							   "new": ["def sub(a, b):", "\treturn a - b"]}]},
						  {"path": "notes.txt", "action": "modify", "changes": [
							  {"op": "replace_text", "old": ["zwei"], "new": ["drei"]}]},
						  {"path": "bild.bin", "action": "add", "new": {"base64": "AAEC"}}]}

	def test_round_trip(self):
		text = patchfile.dumps(self.draft)
		path = os.path.join(self.tmp, "x.ppatch")
		with open(path, "w", encoding="utf-8") as handle:
			handle.write(text)
		patch = patchfile.load(path)
		self.assertEqual(patch["description"], "Zeile 1\nZeile 2")
		self.assertEqual(patch["files"][0]["changes"][0]["new"], ["def run(self):", "\treturn 2"])
		self.assertEqual(patch["files"][2]["new"], {"base64": "AAEC"})
		self.assertEqual(patchfile.dumps(patch), text)

	def test_levels_and_hash_length(self):
		sizes = {}
		self.make_target()
		for level in patchfile.LEVELS:
			path = self.seal(self.draft, "p-%s.ppatch" % level, "--verify", level)
			with open(path, encoding="utf-8") as handle:
				text = handle.read()
			sizes[level] = len(text)
			self.assertEqual(" u=" in text, level != "min")
			self.assertEqual(" c=" in text, level == "full")
			self.assertEqual(self.run_cli("check", path, "-p", self.target), 0, self.last_err)
		self.assertLess(sizes["min"], sizes["std"])
		self.assertLess(sizes["std"], sizes["full"])
		path = self.seal(self.draft, "lang.ppatch", "--hash-len", "64")
		with open(path, encoding="utf-8") as handle:
			self.assertRegex(handle.read(), r"h=[0-9a-f]{64}>[0-9a-f]{64}")

	def test_packages(self):
		self.seal(self.draft, "teil.ppatch", "--max-size", "300")
		parts = sorted(p for p in os.listdir(self.tmp) if p.startswith("teil.") and
					   p.endswith(".ppatch") and p != "teil.ppatch.entwurf")
		self.assertGreater(len(parts), 1)
		for name in parts:
			self.assertLessEqual(os.path.getsize(os.path.join(self.tmp, name)), 300)
		self.make_target()
		last = os.path.join(self.tmp, parts[-1])
		self.assertEqual(self.apply(last), 0, self.last_err)
		self.assertIn(b"return 2", self.read("m.py"))
		missing = os.path.join(self.tmp, parts[0])
		os.remove(missing)
		with self.assertRaises(PatchInvalid):
			patchfile.load(last)

	def test_hashes_are_optional(self):
		path = self.seal(self.draft, "p.ppatch")
		with open(path, encoding="utf-8") as handle:
			text = handle.read()
		stripped = "\n".join(" ".join(t for t in line.split(" ") if not t[:2] in ("h=", "u="))
							 for line in text.splitlines()[1:]) + "\n"
		bare = os.path.join(self.tmp, "ohne.ppatch")
		with open(bare, "w", encoding="utf-8") as handle:
			handle.write(patchfile.split("0001-f", stripped, None)[0])
		self.make_target()
		self.assertEqual(self.apply(bare), 0, self.last_err)

	def test_handwritten_blocks(self):
		text = ("#PPATCH 1 0002-h\nTITLE von Hand\nFILE notes.txt\n"
				"  TEXT @1 @2\n# Kommentar\n@1 .\nzwei\n@.\n@2 .\nzwei\ndrei\n@.\n")
		path = os.path.join(self.tmp, "h.ppatch")
		with open(path, "w", encoding="utf-8") as handle:
			handle.write(text)
		out = os.path.join(self.tmp, "h.sealed.ppatch")
		self.assertEqual(self.run_cli("seal", "-q", path, "--base", self.base, "-o", out), 0,
						 self.last_err)
		self.make_target()
		self.assertEqual(self.apply(out), 0, self.last_err)
		self.assertEqual(self.read("notes.txt"), b"eins\nzwei\ndrei\n")

	def test_draft_needs_seal(self):
		path = os.path.join(self.tmp, "e.ppatch")
		with open(path, "w", encoding="utf-8") as handle:
			handle.write("#PPATCH 1 0001-f\nTITLE x\nDEL notes.txt\n")
		with self.assertRaises(PatchInvalid):
			patchfile.load(path)
		self.assertEqual(patchfile.load(path, verify=False)["files"][0]["action"], "delete")


if __name__ == "__main__":
	unittest.main()
@3 3
- Entwurf: "source" fuer add/replace, Binaerdateien automatisch raw,
	seal --state.
- Beispiel examples/ und 45 Tests (unittest).
@4 13
- Neu angelegte Dateien erhalten die ueblichen Rechte (0666 - umask).
- Beim Schreiben/Wiederherstellen einer .py-Datei wird ihr Bytecode in
	__pycache__ entfernt: Python erkennt veralteten Bytecode nur an
	Aenderungszeit (Sekunden) und Groesse - bei schnellem Patch/Rollback
	mit gleich langem Inhalt lief sonst alter Code (im Selbsttest
	aufgefallen).
- Syntaxpruefung je Datei am Ende statt nach jeder Aenderung
	(Zwischenstaende von Textaenderungen duerfen ungueltig sein).
- create waehlt die ganze Datei, wenn sie kleiner ist als die
	Einzelaenderungen.

Selbsttest: die Aenderungen an pypatcher werden selbst als Patch
erzeugt (create) und angewendet - siehe patch/.
@5 14
0.0.1-pre1 (2026-10-30)
-----------------------
	Erste Implementierung gemaess manifest.txt.
	- Befehle: init, status, verify, log, units, show, seal, check, apply,
		rollback, recover.
	- Patch-Befehle: Dateien add/delete/replace/move/copy; Einheiten
		replace_unit/add_unit/delete_unit/copy_unit/move_unit (auch zwischen
		Dateien, Paar ueber move_id); Text replace_text/insert_text/
		delete_text mit optionalem scope.
	- Vergleichsprofile raw/text/python; Normalform python/1 aus
		Syntaxbaum + Einrueckungs-Signatur; Hash auf Python 3.8, 3.11, 3.12
		und 3.13 identisch (f-String-Teile werden vereinheitlicht, da
		Python 3.12 abweichende Baeume erzeugt).
	- Relative Einrueckung im Patch, layout als Check, Ausweichform literal.
@6 18
	Befehl create:
	- Patch aus zwei Staenden (ALT -> NEU): Einheiten-Vergleich fuer Python
		(UNIT/UADD/UDEL, Abstieg in Klassen), dateiuebergreifende UMOVE-Paare
		und UCOPY, Datei-MOVE/COPY, Rest als Textbloecke mit eindeutigem
		Kontext. Der Patch wird vor dem Speichern im Speicher angewendet und
		Byte fuer Byte mit NEU verglichen; nicht exakt Darstellbares wird als
		ganze Datei aufgenommen.

	Grundfunktionen:
	- Befehle init, status, verify, log, units, show, seal, create, check,
		apply, rollback, recover.
	- Patch-Befehle: Dateien ADD/DEL/REP/MOVE/COPY; Einheiten UNIT/UADD/
		UDEL/UCOPY/UMOVE (auch zwischen Dateien); Text TEXT/TINS/TDEL mit
		optionalem scope.
	- Vergleichsprofile raw/text/python; Normalform python/1 aus Syntaxbaum
		+ Einrueckungs-Signatur; Hash auf Python 3.8, 3.11, 3.12 und 3.13
		identisch (f-String-Teile vereinheitlicht).
	- Relative Einrueckung im Patch, layout als Check, Ausweichform lit.
@7 16
0.0.1-pre2 (2026-10-30)
-----------------------
	- Neuer Befehl create: erzeugt einen Patch aus zwei Staenden (ALT ->
		NEU). Einheiten-Vergleich fuer Python (replace/add/delete_unit, Abstieg
		in Klassen), dateiuebergreifende move_unit-Paare und copy_unit,
		Datei-move/copy, Rest als Textbloecke mit eindeutigem Kontext.
		Der Patch wird vor dem Speichern im Speicher angewendet und Byte fuer
		Byte mit NEU verglichen; nicht exakt Darstellbares wird als ganze
		Datei aufgenommen. Optionen --level, --include-cosmetic, --compare,
		--requires, --description, --author, --no-layout.
	- Fehlerbehebung: neu angelegte Dateien (Patch-Aktion add, gespeicherte
		Patchdateien) hatten die Rechte 0600 der Temp-Datei; jetzt 0666 minus
		umask wie ueblich.
	- Tests fuer create (tests/test_create.py) und Dateirechte.
	- Dieser Stand wurde selbst als Patch erzeugt (create) und mit
		0.0.1-pre1 angewendet: patch/0001-pre2-create.ppatch.json.
@8 16
0.0.1-pre1 (2026-10-30, Testphase - wird bis zur Freigabe fortgeschrieben)
------------------------------------------------------------------------
	Patchformat pypatcher/1 (Befehlsliste + Datenbloecke):
	- Kompaktes Textformat statt JSON: eine Zeile je Befehl (FILE, UNIT,
		UADD, TEXT ...), Code unveraendert in gezaehlten Datenbloecken, kein
		Escaping. Derselbe Patch ist damit rund halb so gross.
	- Pruefstufen --verify min|std|full (nur Datei / zusaetzlich
		Funktionen / alles); Hashes gekuerzt (--hash-len, Standard 16);
		beim Anwenden wird geprueft, was der Patch enthaelt.
	- Kein alter Code mehr im Patch, ausser als Suchtext fuer
		Textaenderungen; Kopien/Verschiebungen holen den Inhalt aus der Quelle.
	- Optionale Pakete (--max-size): Teilung nach Zeichenzahl, Paket- und
		Gesamt-Hash, Laden aus einem beliebigen Paket.
	- Entwuerfe im selben Format, Bloecke "@N ." ... "@." von Hand
		schreibbar; Beispiel examples/entwurf-beispiel.ppatch.
	- show stellt Einrueckungs-Ebenen wie in der Datei dar (--indent).
