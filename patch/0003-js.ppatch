		normalize_unit(text, unit, profil) -> Normalform einer Einheit
		list_units(text)               -> Liste aller Einheiten
		locate(text, unit)             -> (start, ende, quelltext) oder Fehler
		insert(text, position, quelltext) -> neuer Text
		check_indent(text, position, quelltext) -> Einrueckung passt? (python)
		validate(text)                 -> Syntaxpruefung (python: ast.parse)
@21 16
8.1 Schnittstelle (adapters/base.py, jeder Adapter)
		mode, label           Kennung (= Profil-mode) und Anzeigename
		has_units             Einheiten-Befehle moeglich?
		default_indent        Ebenen-Einheit, falls aus der Datei nicht ableitbar
		gap_top, gap_nested   Leerzeilen um eingefuegte Einheiten
		normalize(doc, profil)              -> Normalform der Datei
		normalize_unit(doc, info, unit, p)  -> Normalform einer Einheit
		validate(doc)                       -> Syntaxpruefung (ParseError)
		detect_unit(doc)                    -> Ebenen-Einheit der Datei
		analyze(doc)          -> Info: Zeilen, Einheiten (Eltern vor Kindern)
		find(info, pfad), at_span(info, start, ende), position(info, pos)
		can_contain(unit)     kann Einheiten aufnehmen (start-of:/end-of:)
		opens_block(zeile), closes_block(zeile)   fuer die Abstandsregeln
		rename(zeilen, name)  fuer UCOPY as=
		Profil-Optionen und Dateiendungen stehen in profile.py (MODES,
		EXTENSIONS). Engine und create sind formatunabhaengig.
